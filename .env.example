# Copy to .env and fill in. This is the ONLY setting the website needs.
# The Apps Script web app URL (Deploy → Manage deployments → Web app URL). It is public by design:
# every secret (admin password, Apify token) lives in Apps Script → Project Settings → Script Properties, never here.
VITE_GAS_URL=https://script.google.com/macros/s/XXXXXXXX/exec
